# Šablona proměnných prostředí – jen názvy, žádné hodnoty.
# Skutečné hodnoty patří lokálně do .env.local (je v .gitignore), na Vercelu do Settings → Environment Variables.
# Návod krok za krokem je v README (Nasazení na Supabase a Vercel).

# URL projektu v Supabase, tvar https://<id-projektu>.supabase.co
SUPABASE_URL=

# Secret klíč Supabase (sb_secret_…). Obchází Row Level Security. Používají ho JEN serverless funkce v api/,
# nikdy public/ ani žádný kód, který běží v prohlížeči. Publishable klíč stránka nepotřebuje vůbec.
SUPABASE_SECRET_KEY=

# Náhodný řetězec (aspoň 16 znaků) pro Vercel cron. Vercel ho posílá jako Authorization: Bearer … na /api/keepalive.
CRON_SECRET=
