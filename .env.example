# Šablona proměnných prostředí – jen názvy, žádné hodnoty.
# Skutečné hodnoty patří lokálně do .env.local, na Vercelu do Environment Variables.

# URL projektu v Supabase
SUPABASE_URL=

# Service role (secret) klíč – obchází RLS. Používá ho JEN serverless funkce v api/,
# nikdy public/ ani žádný kód, který běží v prohlížeči.
SUPABASE_SERVICE_ROLE_KEY=
